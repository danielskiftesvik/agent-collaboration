{
  "instances": {
    "codex-business": {
      "harness": "codex",
      "env": { "CODEX_HOME": "~/.codex-business" }
    },
    "claude-local": {
      "harness": "claude",
      "bin": "/path/to/claude-local"
    },
    "cursor": {
      "harness": "cursor",
      "bin": "~/.cursor/bin/agent"
    }
  },
  "defaults": {
    "codex": "codex-business"
  }
}
